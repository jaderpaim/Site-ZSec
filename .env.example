# Variáveis de ambiente da aplicação.
# Copie para .env.local (desenvolvimento) ou para o .env do servidor e preencha.
# NUNCA commite o arquivo preenchido -- só este exemplo vai para o git.
#
# VITE_* entram no build e ficam visíveis no navegador: só valores públicos.
# As demais são lidas apenas no servidor.

# ── Aplicação ─────────────────────────────────────────────────────────────────
# Endereço público desta instância, sem barra no fim. Usado em links de e-mail,
# convites, callback do SSO e nas URLs que os crons chamam.
APP_URL=http://localhost:8080
# Opcional: endereço para o servidor chamar a si mesmo ("Sincronizar agora").
# A imagem Docker já define http://127.0.0.1:3000; sem ela, usa APP_URL.
# INTERNAL_APP_URL=
# Nome do produto exibido em telas, e-mails e alertas.
VITE_APP_NAME=Z-Sec

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API. A URL e a publishable key são públicas; a service
# role ignora o RLS e dá acesso total ao banco: só no servidor.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Segredos internos ─────────────────────────────────────────────────────────
# Gere cada um com:  openssl rand -base64 32
# Chave AES-256 das credenciais de integração guardadas no banco (32 bytes em
# base64). Trocar depois exige recadastrar as integrações.
INTEGRATIONS_ENCRYPTION_KEY=
# Exigido pelos endpoints /api/public/hooks/* (header x-hook-secret) chamados
# pelos crons.
HOOK_SECRET=
# Assina o "state" do login Microsoft (proteção contra CSRF no callback).
SSO_STATE_SECRET=

# ── SSO Microsoft (Entra ID) ──────────────────────────────────────────────────
# Client secret do App Registration (tenant e client id ficam na tela SSO / LDAP).
AZURE_CLIENT_SECRET=
# Opcionais: por padrão são derivados de APP_URL.
# SSO_REDIRECT_URI=https://zsec.empresa.com.br/api/public/auth/azure/callback
# TREINAMENTOS_SSO_REDIRECT_URI=https://zsec.empresa.com.br/api/public/treinamentos/sso/callback

# ── E-mail (SMTP) ─────────────────────────────────────────────────────────────
# Opcional: só se a senha não for cadastrada na tela de SMTP.
# SMTP_PASSWORD=

# ── Agente de estações (pasta agent/) ─────────────────────────────────────────
# Chaves aceitas pelo /api/public/hooks/agent-ingest, separadas por vírgula
# (permite trocar a chave sem derrubar agentes antigos).
# AGENT_INGEST_KEY=

# ── Servidor de scanner DAST / SEK (scripts/dast-provisioning) ────────────────
# Service token do Cloudflare Access na frente do servidor de scanner.
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=
# Base do worker do SEK, sem barra no fim.
# SEK_WORKER_URL=https://scanner.empresa.com.br/sek-worker
# Assina os tokens de renovação de sessão do SEK Session Capture.
# SEK_RENEWAL_SECRET=
